# ── Supabase (requis) ────────────────────────────────────────────────
# Utiliser le MÊME projet Supabase que Cantaia pour réutiliser :
# le compte (auth), les emails synchronisés (email_records) et les
# tokens Microsoft. Un projet Supabase vierge fonctionne aussi, mais
# les sections emails/archivage auto resteront vides.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── IA (analyse financière) ──────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Microsoft (optionnel — archivage automatique des pièces jointes) ─
# Nécessaires uniquement pour le refresh des tokens Graph.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Clé AES-256-GCM (64 hex chars) si les tokens sont chiffrés en base
MICROSOFT_TOKEN_ENCRYPTION_KEY=
